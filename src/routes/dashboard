const express = require("express");

const router = express.Router();

const db = require("../db");
const sendEmail = require("../utils/email");
const auth = require("../middleware/auth");

console.log("📊 DASHBOARD ROUTES LOADED");

// ============================================================
// DEVICES
// ============================================================

router.get("/devices", auth, async (req, res) => {
  try {
    const result = await db.query(
      `
      SELECT *
      FROM devices
      WHERE user_id = $1
      ORDER BY id DESC
      `,
      [req.user.id]
    );

    res.json(result.rows);

  } catch (err) {

    console.error("❌ DEVICES ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ============================================================
// DEVICE EVIDENCE
// ============================================================

router.get("/device/:machine_id", auth, async (req, res) => {
  try {

    const { machine_id } = req.params;

    const check = await db.query(
      `
      SELECT id
      FROM devices
      WHERE machine_id = $1
      AND user_id = $2
      LIMIT 1
      `,
      [
        machine_id,
        req.user.id
      ]
    );

    if (check.rows.length === 0) {
      return res.status(403).json({
        error: "Unauthorized"
      });
    }

    const result = await db.query(
      `
      SELECT *
      FROM device_evidence
      WHERE machine_id = $1
      ORDER BY created_at DESC
      `,
      [machine_id]
    );

    res.json(result.rows);

  } catch (err) {

    console.error("❌ EVIDENCE ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ============================================================
// LATEST DEVICE LOCATION
// ============================================================

router.get("/location/:machine_id", auth, async (req, res) => {

  try {

    const { machine_id } = req.params;

    const result = await db.query(
      `
      SELECT
        d.id AS device_id,
        d.machine_id,
        d.name,
        d.brand,
        d.model,
        d.status,

        dl.id AS location_id,
        dl.ip,
        dl.country,
        dl.city,
        dl.latitude,
        dl.longitude,
        dl.isp,
        dl.created_at

      FROM devices d

      JOIN device_location dl
        ON dl.device_id = d.id

      WHERE d.machine_id = $1
      AND d.user_id = $2

      ORDER BY dl.created_at DESC

      LIMIT 1
      `,
      [
        machine_id,
        req.user.id
      ]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        error: "No location found"
      });
    }

    res.json(result.rows[0]);

  } catch (err) {

    console.error("❌ LOCATION ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ============================================================
// LOCATION HISTORY
// ============================================================

router.get("/history/:machine_id", auth, async (req, res) => {

  try {

    const { machine_id } = req.params;

    let limit =
      parseInt(req.query.limit, 10);

    if (!Number.isFinite(limit)) {
      limit = 200;
    }

    // Prevent huge requests.
    limit = Math.max(
      1,
      Math.min(limit, 1000)
    );

    const result = await db.query(
      `
      SELECT
        dl.id AS location_id,
        d.id AS device_id,
        d.machine_id,
        d.name,
        d.brand,
        d.model,
        d.status,

        dl.ip,
        dl.country,
        dl.city,
        dl.latitude,
        dl.longitude,
        dl.isp,
        dl.created_at

      FROM devices d

      JOIN device_location dl
        ON dl.device_id = d.id

      WHERE d.machine_id = $1
      AND d.user_id = $2
      AND dl.latitude IS NOT NULL
      AND dl.longitude IS NOT NULL

      ORDER BY dl.created_at ASC

      LIMIT $3
      `,
      [
        machine_id,
        req.user.id,
        limit
      ]
    );

    res.json({
      success: true,
      machine_id,
      count: result.rows.length,
      locations: result.rows
    });

  } catch (err) {

    console.error("❌ LOCATION HISTORY ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ============================================================
// LIVE MAP DATA
// ============================================================

router.get("/map", auth, async (req, res) => {

  try {

    const result = await db.query(
      `
      SELECT DISTINCT ON (d.id)

        d.id AS device_id,
        d.machine_id,
        d.name,
        d.type,
        d.brand,
        d.model,
        d.status,
        d.owner_name,

        dl.ip,
        dl.country,
        dl.city,
        dl.latitude,
        dl.longitude,
        dl.isp,

        dl.created_at AS location_time,
        d.last_seen

      FROM devices d

      JOIN device_location dl
        ON dl.device_id = d.id

      WHERE d.user_id = $1
      AND dl.latitude IS NOT NULL
      AND dl.longitude IS NOT NULL

      ORDER BY
        d.id,
        dl.created_at DESC
      `,
      [req.user.id]
    );

    res.json(result.rows);

  } catch (err) {

    console.error("❌ MAP ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

