// ============================================================
// MARK AS STOLEN
// ============================================================

router.post("/mark-stolen", auth, async (req, res) => {

  try {

    const { machine_id } = req.body;

    if (!machine_id) {
      return res.status(400).json({
        error: "machine_id is required"
      });
    }

    const updated = await db.query(
      `
      UPDATE devices
      SET status = 'stolen'

      WHERE machine_id = $1
      AND user_id = $2

      RETURNING machine_id
      `,
      [
        machine_id,
        req.user.id
      ]
    );

    if (updated.rows.length === 0) {
      return res.status(404).json({
        error: "Device not found"
      });
    }

    const result = await db.query(
      `
      SELECT users.email
      FROM devices

      JOIN users
        ON devices.user_id = users.id

      WHERE devices.machine_id = $1
      AND devices.user_id = $2

      LIMIT 1
      `,
      [
        machine_id,
        req.user.id
      ]
    );

    if (result.rows.length > 0) {

      const email = result.rows[0].email;

      await sendEmail(
        email,
        "🚨 DeviceGuard Alert: Device Marked Stolen",
        `
        <h2>🚨 DeviceGuard Security Alert</h2>

        <p>
          Your device has been marked as
          <b>STOLEN</b>.
        </p>

        <p>
          <b>Machine ID:</b>
          ${machine_id}
        </p>

        <p>
          <b>Time:</b>
          ${new Date().toLocaleString()}
        </p>

        <p>
          DeviceGuard protection is now active.
        </p>

        <br>

        <p>
          — DeviceGuard Team
        </p>
        `
      );
    }

    res.json({
      success: true,
      message: "Device marked as stolen"
    });

  } catch (err) {

    console.error("❌ MARK STOLEN ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

