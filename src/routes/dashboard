const express = require("express");
const router = express.Router();
const db = require("../db");
const sendEmail = require("../utils/email");
const auth = require("../middleware/auth");

console.log("📊 DASHBOARD ROUTES LOADED");

// ================= DEVICES =================
router.get("/devices", auth, async (req, res) => {

  try {

    const result = await db.query(`
      SELECT *
      FROM devices
      WHERE user_id = $1
      ORDER BY id DESC
    `, [req.user.id]);

    res.json(result.rows);

  } catch (err) {

    console.error("❌ DEVICES ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= DEVICE EVIDENCE =================
router.get("/device/:machine_id", auth, async (req, res) => {

  try {

    const { machine_id } = req.params;

    const check = await db.query(`
      SELECT *
      FROM devices
      WHERE machine_id = $1
      AND user_id = $2
    `, [machine_id, req.user.id]);

    if (check.rows.length === 0) {

      return res.status(403).json({
        error: "Unauthorized"
      });
    }

    const result = await db.query(`
      SELECT *
      FROM device_evidence
      WHERE machine_id = $1
      ORDER BY created_at DESC
    `, [machine_id]);

    res.json(result.rows);

  } catch (err) {

    console.error("❌ EVIDENCE ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= LIVE LOCATION =================
router.get("/location/:machine_id", auth, async (req, res) => {

  try {

    const { machine_id } = req.params;

    const result = await db.query(`
      SELECT *
      FROM device_location
      WHERE device_id = $1
      ORDER BY id DESC
      LIMIT 1
    `, [machine_id]);

    if (result.rows.length === 0) {

      return res.status(404).json({
        error: "No location found"
      });
    }

    res.json(result.rows[0]);

  } catch (err) {

    console.error("❌ LOCATION ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= MAP DATA =================
router.get("/map", auth, async (req, res) => {

  try {

    const result = await db.query(`
      SELECT
        machine_id,
        status,
        city,
        country,
        latitude,
        longitude,
        last_seen
      FROM devices
      WHERE latitude IS NOT NULL
      AND longitude IS NOT NULL
      AND user_id = $1
      ORDER BY id DESC
    `, [req.user.id]);

    res.json(result.rows);

  } catch (err) {

    console.error("❌ MAP ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= EVIDENCE MAP =================
router.get("/evidence-map", auth, async (req, res) => {

  try {

    const result = await db.query(`
      SELECT *
      FROM device_evidence
      WHERE latitude IS NOT NULL
      AND longitude IS NOT NULL
      AND machine_id IN (
        SELECT machine_id
        FROM devices
        WHERE user_id = $1
      )
      ORDER BY created_at DESC
    `, [req.user.id]);

    res.json(result.rows);

  } catch (err) {

    console.error("❌ EVIDENCE MAP ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= MARK AS STOLEN =================
router.post("/mark-stolen", auth, async (req, res) => {

  try {

    const { machine_id } = req.body;

    await db.query(`
      UPDATE devices
      SET status = 'stolen'
      WHERE machine_id = $1
      AND user_id = $2
    `, [machine_id, req.user.id]);

    const result = await db.query(`
      SELECT users.email
      FROM devices
      JOIN users
      ON devices.user_id = users.id
      WHERE devices.machine_id = $1
      LIMIT 1
    `, [machine_id]);

    if (result.rows.length > 0) {

      const email = result.rows[0].email;

      await sendEmail(
        email,
        "🚨 DeviceGuard Alert: Device Marked Stolen",
        `
        <h2>🚨 DeviceGuard Security Alert</h2>

        <p>Your device has been marked as <b>STOLEN</b>.</p>

        <p><b>Machine ID:</b> ${machine_id}</p>

        <p><b>Time:</b> ${new Date().toLocaleString()}</p>

        <p>DeviceGuard is now collecting evidence.</p>

        <br>

        <p>— DeviceGuard Team</p>
        `
      );
    }

    res.json({
      success: true
    });

  } catch (err) {

    console.error("❌ MARK STOLEN ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

// ================= MARK SAFE =================
router.post("/mark-safe", auth, async (req, res) => {

  try {

    const { machine_id } = req.body;

    await db.query(`
      UPDATE devices
      SET status = 'active'
      WHERE machine_id = $1
      AND user_id = $2
    `, [machine_id, req.user.id]);

    res.json({
      success: true
    });

  } catch (err) {

    console.error("❌ MARK SAFE ERROR:", err);

    res.status(500).json({
      error: err.message
    });
  }
});

module.exports = router;